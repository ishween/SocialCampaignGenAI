# Copy this file to .env and fill in your key
# Never commit .env to git

# Required — used for all three Google models:
#   Imagen 3              (image generation)
#   Gemini 2.0 Flash      (image quality evaluation)
#   Gemini 2.0 Flash-Lite (prompt refinement, input validation)
GOOGLE_API_KEY=your_google_api_key_here
